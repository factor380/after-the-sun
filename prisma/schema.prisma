generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id          String   @id @db.Uuid
  displayName String?
  createdAt   DateTime @default(now())
  spots       Spot[]
  reports     SpotReport[]
  spotPhotos  SpotPhoto[]
}

model Spot {
  id          String   @id @default(cuid())
  name        String
  description String
  lat         Float
  lng         Float
  region      String?
  photoUrl        String?
  /// yes | paid | no. Null when the contributor skipped the question.
  parking             String?
  parkingNote         String?  @map("parking_note")
  /// yes | partial | no. Null when the contributor skipped the question.
  accessibility       String?
  accessibilityNote   String?  @map("accessibility_note")
  /// Null for a suggestion sent without an account. Editing stays owner-only.
  createdById     String?  @db.Uuid
  /// pending | approved | rejected. Existing rows default to approved.
  status          String   @default("approved")
  /// Public credit. Google display name, or the optional name on a suggestion.
  contributorName String?
  /// One create-submit attempt. Null on spots saved before idempotency keys.
  clientRequestId String?  @map("client_request_id")
  createdBy       Profile? @relation(fields: [createdById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  reports         SpotReport[]
  photos          SpotPhoto[]

  @@unique([createdById, clientRequestId])
  @@index([lat, lng])
  @@index([region])
  @@index([status, createdAt])
}

/** Community photos contributed to an existing spot by any signed-in user. */
model SpotPhoto {
  id           String   @id @default(cuid())
  spotId       String
  spot         Spot     @relation(fields: [spotId], references: [id], onDelete: Cascade)
  url          String
  uploadedById String   @db.Uuid
  uploadedBy   Profile  @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@unique([spotId, url])
  @@index([spotId, createdAt])
  @@index([uploadedById])
}

/** User reports for moderation - review via Prisma Studio for now. */
model SpotReport {
  id         String   @id @default(cuid())
  spotId     String
  spot       Spot     @relation(fields: [spotId], references: [id], onDelete: Cascade)
  reporterId String   @db.Uuid
  reporter   Profile  @relation(fields: [reporterId], references: [id])
  reason     String
  details    String?
  createdAt  DateTime @default(now())

  @@index([spotId, createdAt])
  @@index([createdAt])
}
