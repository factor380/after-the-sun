# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Supabase → Settings → Database → Connection string
# Use Transaction pooler for DATABASE_URL (port 6543) and Session/direct for DIRECT_URL (port 5432)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Optional. Public origin for canonical URLs, sitemap, and Open Graph.
# Localhost is ignored (canonicals stay on the production domain).
# Production default when unset: https://after-the-sun.com
NEXT_PUBLIC_SITE_URL=http://localhost:3004

# Optional. Google Cloud web OAuth client id (public). When set, Google sign-in
# runs on this site and the account chooser shows this origin. When unset or
# invalid, sign-in falls back to the Supabase OAuth redirect.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=123456789012-abcdef.apps.googleusercontent.com

# Geoapify → https://www.geoapify.com (free tier). Server-side only; never exposed to the browser.
# Optional. When set, place search uses Geoapify. Without it, search uses OpenStreetMap.
GEOAPIFY_API_KEY=your_geoapify_api_key

# Test-only. Do not set E2E_TEST_AUTH on Vercel or any public host.
# The server ignores it when VERCEL=1 or VERCEL_ENV=production.
# E2E_TEST_AUTH=1
